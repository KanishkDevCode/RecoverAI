# Environment variables for RecoverAI

# Environment (development/production)
ENVIRONMENT=development

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=test_key_id_here
RAZORPAY_KEY_SECRET=test_key_secret_here

# Application Secrets
MERCHANT_API_KEY=test_secret_key_123
WEBHOOK_SECRET=test_webhook_secret_456

# LLM API Keys (For Diagnosis Agent)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=mock

# Database Settings
DATABASE_URL=sqlite:///./recoverai.db

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Policy Thresholds
MAX_RETRIES=2
AUTO_ACTION_LIMIT=5000.00
MIN_RECOVERY_PROBABILITY=0.60
