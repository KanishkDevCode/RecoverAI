# Environment variables for RecoverAI

# Application Environment
ENVIRONMENT=development

# Database Settings
# Replace with your PostgreSQL URL for production (e.g. Neon.tech, Supabase, etc.)
DATABASE_URL=sqlite:///./recoverai.db

# Celery & Redis Configuration
# Replace with your real Redis URL (e.g. Upstash, Redis Cloud)
CELERY_BROKER_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials / Payment Gateway
RAZORPAY_KEY_ID=test_key_id_here
RAZORPAY_KEY_SECRET=test_key_secret_here
MERCHANT_API_KEY=test_secret_key_123

# Webhook Verification Secret
WEBHOOK_SECRET=test_webhook_secret_456

# LLM API Keys (For Diagnosis Agent)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Policy Thresholds
MAX_RETRIES=2
AUTO_ACTION_LIMIT=5000.00
MIN_RECOVERY_PROBABILITY=0.60
