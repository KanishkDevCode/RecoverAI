# Environment variables for RecoverAI

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=test_key_id_here
RAZORPAY_KEY_SECRET=test_key_secret_here

# LLM API Keys (For Diagnosis Agent)
OPENAI_API_KEY=your_openai_api_key_here

# Database Settings
DATABASE_URL=sqlite:///./recoverai.db

# Policy Thresholds
MAX_RETRIES=2
AUTO_ACTION_LIMIT=5000.00
MIN_RECOVERY_PROBABILITY=0.60
