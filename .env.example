# Environment variables for RecoverAI Production Deployment

# Application Environment (Set to 'production' for strict security validation)
ENVIRONMENT=production

# Database Settings (Must be a non-SQLite database in production)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Celery & Redis Configuration (e.g., Render Redis, Upstash)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Payment Provider Configuration
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_verification_secret

# LLM Agent Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

# Security & CORS (Must be explicit in production, e.g. https://recoverai.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Observability Configuration
OBSERVABILITY_API_KEY=your_observability_key
LOG_LEVEL=INFO

# Business Policy Thresholds
MAX_RETRIES=2
AUTO_ACTION_LIMIT=5000.00
MIN_RECOVERY_PROBABILITY=0.60
